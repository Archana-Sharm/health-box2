# MongoDB
MONGODB_URI=mongodb://localhost:27017/health_box_db
PORT=5001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap (used only by `npm run admin:create`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Health Box Admin

# CORS
CORS_ORIGIN=http://localhost:8081

# Uploads
UPLOAD_MAX_SIZE_MB=5
